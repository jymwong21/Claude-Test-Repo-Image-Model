# ── Flux LoRA Studio environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. Only HF_TOKEN is strictly required.

# Hugging Face token — REQUIRED to download FLUX.1-dev (a gated model).
# 1. Create a token: https://huggingface.co/settings/tokens
# 2. Accept the license: https://huggingface.co/black-forest-labs/FLUX.1-dev
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base model repo. FLUX.1-dev gives the best LoRA quality (gated, needs license).
# FLUX.1-schnell is ungated but distilled and trains worse.
BASE_MODEL=black-forest-labs/FLUX.1-dev

# Where everything lives on the pod. On RunPod, point this at the persistent
# /workspace volume so models/datasets survive pod restarts.
DATA_DIR=/workspace/flux-lora-studio/data

# Server host/port for the web UI.
HOST=0.0.0.0
PORT=8000

# Optional: caption backend. "florence2" (local, default) or "none".
CAPTION_BACKEND=florence2
